<Window x:Class="PoleStar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoleStar"
        mc:Ignorable="d"
        Title="Polestar España"
        Width="1280" Height="720"
        MinWidth="1000" MinHeight="600">

    <Window.Resources>
        <Storyboard x:Key="Sacudida">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-10"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="10"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.23" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Grid__raiz_">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Cabecera"
                Grid.Row="0"
                Background="{StaticResource Negro}">
            <StackPanel x:Name="Logo"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0">
                <TextBlock Text="POLESTAR"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock Text="ESPAÑA"
                           Foreground="{StaticResource Acento}"
                           FontSize="12"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,4"/>
            </StackPanel>
        </Border>

        <TabControl ItemContainerStyle="{DynamicResource EstiloOpcionMenu}" Style="{DynamicResource PlantillaNavegacion}" x:Name="Pantallas" Grid.Row="1" SelectionChanged="Pantallas_SelectionChanged">

            <TabItem x:Name="TabInicio" Header="Inicio">
                <ScrollViewer x:Name="ScrollInicio" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Grid x:Name="Hero" Height="420" Background="{StaticResource FondoImagen}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="60,0,0,0">
                                <TextBlock Text="NOVEDAD" Style="{StaticResource Etiqueta}" FontSize="14"/>
                                <TextBlock Text="Polestar 4" FontSize="64" FontWeight="Light" Foreground="{StaticResource Negro}"/>
                                <TextBlock Text="El SUV coupé eléctrico que redefine el diseño: líneas limpias, sin luneta trasera y mucho espacio interior."
                                           FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" Margin="0,0,24,28"/>
                                <Button x:Name="BtnDescubrir" Content="Descubrir" Style="{StaticResource BotonPrimario}"
                                        Click="IrAGaleria_Click"
                                        AutomationProperties.Name="Descubrir el Polestar 4 en la galería"/>
                            </StackPanel>
                            <Image Grid.Column="1" Source="Imagenes/POLESTAR_4_SUV.png" Stretch="Uniform"
                                   AutomationProperties.Name="Polestar 4 SUV, vista lateral"/>
                        </Grid>

                        <StackPanel Margin="50,50,50,30">
                            <TextBlock Text="Ofertas destacadas" Style="{StaticResource TituloSeccion}" Margin="10,0,0,16"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="MODELO TOP" Style="{StaticResource Etiqueta}"/>
                                        <TextBlock Text="Polestar 3" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                        <TextBlock Text="El SUV eléctrico de altas prestaciones, con la tecnología más completa de la gama."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="60"/>
                                        <TextBlock Text="Desde 79.900 € *" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/>
                                        <Button Content="Ver oferta" Style="{StaticResource BotonSecundario}" Click="IrAGaleria_Click"
                                                AutomationProperties.Name="Ver oferta del Polestar 3"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="CAMPAÑA DE OTOÑO" Style="{StaticResource Etiqueta}"/>
                                        <TextBlock Text="Polestar 4" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                        <TextBlock Text="Condiciones especiales de financiación durante la campaña de otoño."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="60"/>
                                        <TextBlock Text="Desde 62.900 € *" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/>
                                        <Button Content="Ver oferta" Style="{StaticResource BotonSecundario}" Click="IrAGaleria_Click"
                                                AutomationProperties.Name="Ver oferta del Polestar 4"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="MEJOR PRECIO" Style="{StaticResource Etiqueta}"/>
                                        <TextBlock Text="Polestar 2" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                        <TextBlock Text="La puerta de entrada a la marca: berlina eléctrica con el mejor precio de la gama."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="60"/>
                                        <TextBlock Text="Desde 49.900 € *" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/>
                                        <Button Content="Ver oferta" Style="{StaticResource BotonSecundario}" Click="IrAGaleria_Click"
                                                AutomationProperties.Name="Ver oferta del Polestar 2"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="* Precios ficticios, solo para este prototipo académico." FontSize="12"
                                       Foreground="{StaticResource GrisTexto}" Margin="10,4,0,0"/>
                        </StackPanel>

                        <Border Background="{StaticResource GrisClaro}" Padding="60,50">
                            <StackPanel>
                                <TextBlock Text="¿Por qué Polestar?" Style="{StaticResource TituloSeccion}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Diseño escandinavo" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Formas limpias y materiales cuidados, pensados para durar."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="100 % eléctrico" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Una gama sin motores de combustión, orientada a la movilidad sostenible."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tecnología y seguridad" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Asistentes de conducción y conectividad integrada en cada modelo."
                                                   TextWrapping="Wrap" Foreground="{StaticResource GrisTexto}" FontSize="14" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Negro}" Padding="60,36">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Información legal" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="Prototipo académico de Interfaces de Usuario (UMH). No es un sitio oficial de Polestar."
                                               TextWrapping="Wrap" Foreground="#FFBFBFBF" FontSize="13" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Contacto" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="Atención al cliente (ejemplo): 900 000 000"
                                               TextWrapping="Wrap" Foreground="#FFBFBFBF" FontSize="13" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Redes" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="Instagram · YouTube · LinkedIn (ejemplo)"
                                               TextWrapping="Wrap" Foreground="#FFBFBFBF" FontSize="13" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabLogin" Header="Login">
                <Grid Background="{StaticResource GrisClaro}">
                    <Border x:Name="TarjetaLogin" Width="420" Background="White" Padding="40" CornerRadius="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="My Polestar Space" FontSize="28" Margin="0,0,0,24"/>

                            <Label Content="_Usuario" Target="{Binding ElementName=TxtUsuario}" Padding="0,0,0,4"/>
                            <TextBox x:Name="TxtUsuario" FontSize="15" Padding="8" TabIndex="0"
                                     AutomationProperties.Name="Usuario"/>

                            <Label Content="_Contraseña" Target="{Binding ElementName=PwdClave}" Padding="0,0,0,4" Margin="0,16,0,0"/>
                            <PasswordBox x:Name="PwdClave" FontSize="15" Padding="8" TabIndex="1"
                                         AutomationProperties.Name="Contraseña"/>

                            <TextBlock x:Name="TxtError" Text="Usuario o contraseña incorrectos."
                                       Foreground="{StaticResource Error}" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Visibility="Collapsed" Margin="0,16,0,0" TextWrapping="Wrap"/>

                            <Button x:Name="BtnEntrar" Content="Entrar" Style="{StaticResource BotonPrimario}"
                                    HorizontalAlignment="Stretch" Margin="0,24,0,0" IsDefault="True" TabIndex="2"
                                    Click="BtnEntrar_Click" AutomationProperties.Name="Entrar"/>

                            <TextBlock Text="Demo: usuario «cliente», contraseña «polestar»."
                                       FontSize="12" Foreground="{StaticResource GrisTexto}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabGaleria" Header="Galería">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="50,40,50,40">
                        <TextBlock Text="Galería de modelos" Style="{StaticResource TituloSeccion}" Margin="10,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="10,0,0,12">
                            <Label Content="_Filtrar por tipo:" Target="{Binding ElementName=CmbFiltro}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFiltro" Width="160" SelectedIndex="0" VerticalAlignment="Center"
                                      SelectionChanged="CmbFiltro_SelectionChanged"
                                      AutomationProperties.Name="Filtrar modelos por tipo">
                                <ComboBoxItem Content="Todos" Tag="Todos"/>
                                <ComboBoxItem Content="Berlina" Tag="Berlina"/>
                                <ComboBoxItem Content="SUV" Tag="SUV"/>
                            </ComboBox>
                        </StackPanel>

                        <WrapPanel x:Name="PanelGaleria">
                            <Border Style="{StaticResource Tarjeta}" Width="350" Tag="Berlina">
                                <StackPanel>
                                    <Image Source="Imagenes/POLESTAR_2.png" Height="130" Stretch="Uniform" AutomationProperties.Name="Polestar 2"/>
                                    <TextBlock Text="BERLINA" Style="{StaticResource Etiqueta}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Polestar 2" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <TextBlock Text="Berlina eléctrica compacta, la puerta de entrada a la marca." TextWrapping="Wrap"
                                               Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="40"/>
                                    <TextBlock Text="Desde 49.900 € *" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}" Width="350" Tag="SUV">
                                <StackPanel>
                                    <Image Source="Imagenes/POLESTAR_3.png" Height="130" Stretch="Uniform" AutomationProperties.Name="Polestar 3"/>
                                    <TextBlock Text="SUV" Style="{StaticResource Etiqueta}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Polestar 3" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <TextBlock Text="SUV eléctrico de altas prestaciones con la tecnología más completa." TextWrapping="Wrap"
                                               Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="40"/>
                                    <TextBlock Text="Desde 79.900 € *" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}" Width="350" Tag="SUV">
                                <StackPanel>
                                    <Image Source="Imagenes/POLESTAR_4_SUV.png" Height="130" Stretch="Uniform" AutomationProperties.Name="Polestar 4 SUV"/>
                                    <TextBlock Text="SUV" Style="{StaticResource Etiqueta}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Polestar 4" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <TextBlock Text="SUV coupé sin luneta trasera, con gran espacio interior." TextWrapping="Wrap"
                                               Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="40"/>
                                    <TextBlock Text="Desde 62.900 € *" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}" Width="350" Tag="SUV">
                                <StackPanel>
                                    <Image Source="Imagenes/PLESTAR_4_COUPE.png" Height="130" Stretch="Uniform" AutomationProperties.Name="Polestar 4 Coupé"/>
                                    <TextBlock Text="SUV COUPÉ" Style="{StaticResource Etiqueta}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Polestar 4 Coupé" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <TextBlock Text="Variante del Polestar 4 con silueta coupé." TextWrapping="Wrap"
                                               Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="40"/>
                                    <TextBlock Text="Desde 64.900 € *" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tarjeta}" Width="350" Tag="Berlina">
                                <StackPanel>
                                    <Image Source="Imagenes/POLESTAR_5.png" Height="130" Stretch="Uniform" AutomationProperties.Name="Polestar 5"/>
                                    <TextBlock Text="BERLINA GT" Style="{StaticResource Etiqueta}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Polestar 5" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <TextBlock Text="Gran turismo eléctrico de cuatro puertas, el modelo más deportivo." TextWrapping="Wrap"
                                               Foreground="{StaticResource GrisTexto}" FontSize="14" MinHeight="40"/>
                                    <TextBlock Text="Desde 119.900 € *" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="* Precios ficticios, solo para este prototipo académico." FontSize="12"
                                   Foreground="{StaticResource GrisTexto}" Margin="10,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
